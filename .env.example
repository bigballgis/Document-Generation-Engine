# Copy this file to .env and adjust values for local development.
# docker-compose and the backend read these variables.
#
# JWT_SECRET — LOCAL vs ACCEPTANCE/PROD
# - This file is for local / developer machines only.
# - The documented local-dev JWT value below is OK for APP_ENVIRONMENT=dev (and local/test
#   Spring profiles). Never reuse it in acceptance, staging, or production.
# - For acceptance/prod compose, queued docker-deploy, or container-hardening-smoke:
#   export a unique ≥32-byte JWT_SECRET yourself. Do NOT rely on compose `${JWT_SECRET:-…}`
#   defaults (there must be none). Do NOT use:
#     local-dev-only-change-me-please-32bytes-min
#     prod-change-me-32-bytes-minimum-secret
#   See docs/behavior/ops-jwt-secret-no-default.md (BDD-OPS-JWT-SECRET-001) and
#   docs/operations/runbook.md § Required environment variables.
#
# DOCGEN_AD_GROUP_ALLOW_CONFIG_STUB — LAB / local docker acceptance ONLY
# - Maps to docgen.ad-group-resolver.allow-config-stub-on-prod-profile (via compose).
# - docker-compose.prod.yml defaults this to true so local E2E can keep type=config maps.
# - Claimed production MUST omit or set false — config stub is NOT enterprise AD/LDAP.
# - See docs/behavior/ops-ad-group-stub-close.md (BDD-OPS-AD-GROUP-STUB-001) / ADR-0054.

# ---- Deployment environment marker (used by /api/{environment}/v1) ----
APP_ENVIRONMENT=dev

# ---- PostgreSQL ----
POSTGRES_DB=docgen
POSTGRES_USER=docgen
POSTGRES_PASSWORD=docgen_local_pwd
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
IDEMPOTENCY_CACHE=redis

# ---- Kafka ----
# KAFKA_IMAGE — LOCAL/DEV ONLY example below.
# - Compose requires an explicit KAFKA_IMAGE (fail-closed `${KAFKA_IMAGE:?…}` — no Hub silent default).
# - The bitnamilegacy value is a non-production local/dev example only.
# - NEVER claim bitnamilegacy/kafka:3.7 as a production coordinate.
# - Production / acceptance: set KAFKA_IMAGE to a company-approved full ref
#   shaped like <company-registry>/<kafka-image>:<tag>
#   (company registry hostname is UNKNOWN in-repo — do not invent one).
# - See docs/behavior/ops-kafka-company-registry.md (BDD-OPS-KAFKA-REGISTRY-001) and
#   docs/operations/runbook.md § Required environment variables.
KAFKA_IMAGE=bitnamilegacy/kafka:3.7
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# in-process (default) or kafka
ASYNC_TRANSPORT=in-process

# ---- MinIO (object storage) ----
MINIO_ROOT_USER=docgen
MINIO_ROOT_PASSWORD=docgen_local_pwd
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=docgen-dev

# ---- Backend ----
BACKEND_PORT=8080
# LOCAL DEV ONLY — documented test secret for APP_ENVIRONMENT=dev / local/test profiles.
# Never reuse in acceptance, staging, or production (see header comment).
JWT_SECRET=local-dev-only-change-me-please-32bytes-min
# PRR-D01b: actuator scrape HTTP Basic (prod / acceptance-hardening). No image default —
# leave empty locally (dev keeps scrape anonymous); set unique secrets for claimed-prod scrape.
# DOCGEN_ACTUATOR_SCRAPE_USERNAME=
# DOCGEN_ACTUATOR_SCRAPE_PASSWORD=
# LibreOffice PDF conversion: cli (default; embedded in docgen-backend Docker image) or docker-exec (sidecar)
LIBREOFFICE_COMMAND=soffice
LIBREOFFICE_CONVERSION_MODE=cli
LIBREOFFICE_DOCKER_CONTAINER=docgen-libreoffice

# ---- Demo catalog (Docker deploy) ----
# Seed the single FOL executive demo template on deploy (idempotent refresh).
DOCGEN_IMPORT_FOL_DEMO=false
# Legacy RETAIL letter demo — keep false; use FOL demo instead.
DOCGEN_SEED_DEMO_CATALOG=false

# ---- Frontend ----
FRONTEND_PORT=5173
