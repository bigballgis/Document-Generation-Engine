# ---- Java / Maven ----
backend/target/
*.class
*.jar
*.war
!**/src/**/*.jar
hs_err_pid*

# ---- Node / Frontend ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# ---- Env / Secrets ----
.env
*.local
!.env.example

# ---- IDE / OS ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---- Build / runtime artifacts ----
artifacts/
logs/
*.log

# ---- Agent / tooling workspace (machine-local state, do not commit) ----
# Claude Code auto-commits working changes locally to prevent loss (see
# .claude/settings.json Stop hook + hourly cron). The hook/settings source IS
# committed, but per-machine runtime state stays local.
.claude/projects/
.claude/worktrees/
.claude/scheduled_tasks.json
.claude/*.log

# Copilot Plus machine-local workspace
.copilotPlus/

# Auto-generated MCP/skills awareness report (refreshed on each toolbox scan)
.claude/cloude-code-toolbox-mcp-skills-awareness.md
