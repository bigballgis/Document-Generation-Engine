# ---- Agent / tooling workspace (machine-local state, do not commit) ----
# Claude Code auto-commits working changes locally to prevent loss (see
# .claude/settings.json Stop hook + hourly cron). The hook/settings source IS
# committed, but per-machine runtime state stays local.
.claude/projects/
.claude/worktrees/
.claude/scheduled_tasks.json
.claude/*.log

# Cursor agent runtime (deploy queue lock, worktree tickets)
.cursor/runtime/

# Copilot Plus machine-local workspace
.copilotPlus/

# Auto-generated MCP/skills awareness report (refreshed on each toolbox scan)
.claude/cloude-code-toolbox-mcp-skills-awareness.md

# Logs
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
# Dependency directories
node_modules/
# Environment variables
# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# OS specific

# Task files
# tasks.json
# tasks/

# ---- task-master-ai (new task source from 2026-07-05; see ADR-0053) ----
# tasks.json IS committed (it is the source of truth). Only ignore runtime state.
.taskmaster/.env
.taskmaster/logs/
.taskmaster/report*.json
.taskmaster/.taskmaster-config.local.json

# LR-D6 local-only override (copy from .example; never auto-loaded by docker-deploy)
docker-compose.load-smoke.override.yml

# Local toolchains downloaded into the worktree (e.g. Temurin JDK for agents)
.tools/

