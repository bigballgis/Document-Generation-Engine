{
  "version": 1,
  "hooks": {
    "subagentStop": [
      {
        "command": ".cursor/hooks/chain-commit-review.sh",
        "matcher": "post-task-doc-sync"
      },
      {
        "command": ".cursor/hooks/chain-doc-sync.sh",
        "matcher": "backend-engineer"
      },
      {
        "command": ".cursor/hooks/chain-doc-sync.sh",
        "matcher": "frontend-engineer"
      },
      {
        "command": ".cursor/hooks/chain-doc-sync.sh",
        "matcher": "rendering-engineer"
      }
    ]
  }
}
