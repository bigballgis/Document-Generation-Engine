{
  "name": "docgen-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "codegen:openapi": "openapi-typescript ../docs/api/openapi-v1.yaml -o src/types/generated/openapi-v1.ts",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit",
    "knip": "knip",
    "knip:prod": "knip --production",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docker": "playwright test e2e/catalog.spec.ts e2e/role-journeys.spec.ts e2e/master-replace-docx.spec.ts e2e/content-module-lifecycle.spec.ts e2e/collaboration-todos.spec.ts e2e/a11y-smoke.spec.ts e2e/LRP-C12-keyboard-journey.spec.ts e2e/sor-a11y-axe.spec.ts e2e/sor-journey-gaps.spec.ts --config playwright.docker.config.ts",
    "test:e2e:docker:demos": "playwright test e2e/demo-runtime-generate.spec.ts --config playwright.docker.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "pretest:e2e": "playwright install chromium",
    "sbom": "cyclonedx-npm --ignore-npm-errors --no-validate --spec-version 1.6 --output-file ../artifacts/sbom/frontend-cyclonedx.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.39",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cyclonedx/cyclonedx-npm": "^5.0.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/test-utils": "^2.4.6",
    "adm-zip": "^0.5.18",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "jsdom": "^25.0.1",
    "knip": "^6.26.0",
    "openapi-typescript": "7.6.1",
    "sass": "^1.83.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
