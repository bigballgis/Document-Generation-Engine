{
  "name": "docgen-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "codegen:openapi": "openapi-typescript ../docs/api/openapi-v1.yaml -o src/types/generated/openapi-v1.ts",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit",
    "knip": "knip",
    "knip:prod": "knip --production",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docker": "playwright test e2e/catalog.spec.ts e2e/role-journeys.spec.ts e2e/master-replace-docx.spec.ts e2e/content-module-lifecycle.spec.ts e2e/collaboration-todos.spec.ts e2e/a11y-smoke.spec.ts e2e/LRP-C12-keyboard-journey.spec.ts e2e/sor-a11y-axe.spec.ts e2e/sor-journey-gaps.spec.ts --config playwright.docker.config.ts",
    "test:e2e:docker:demos": "playwright test e2e/demo-runtime-generate.spec.ts --config playwright.docker.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "pretest:e2e": "playwright install chromium",
    "sbom": "cyclonedx-npm --ignore-npm-errors --no-validate --spec-version 1.6 --output-file ../artifacts/sbom/frontend-cyclonedx.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "element-plus": "^2.14.3",
    "pdfjs-dist": "4.10.38",
    "pinia": "^2.3.1",
    "vue": "^3.5.39",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cyclonedx/cyclonedx-npm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/test-utils": "^2.4.11",
    "adm-zip": "^0.5.18",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "jsdom": "^25.0.1",
    "knip": "^6.26.0",
    "openapi-typescript": "7.13.0",
    "sass": "^1.101.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
