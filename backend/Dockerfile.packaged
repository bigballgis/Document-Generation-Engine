# Runtime image — copies pre-built JAR from backend/target (see scripts/docker-deploy.ps1).
# ADR-0030 / P15-T01: non-root JRE (UID 65532); mount /tmp tmpfs with read-only root FS.
# LibreOffice headless is embedded for Docker acceptance PDF conversion (cli mode; ADR-0019).
# LR-A2 / ADR-0041: rendering font baseline — CJK + metric-compatible substitutes for
# Calibri/Cambria so bank correspondence renders without tofu or layout drift (CD-PIT-01).
#
# Base switched from eclipse-temurin:21-jre-alpine to eclipse-temurin:21-jre-jammy (Debian 22.04)
# because Alpine 3.23 has no font-crosextra-caladea package; Debian carries the full
# fonts-crosextra-caladea / fonts-crosextra-carlito set required by the rendering font baseline.
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libreoffice-core \
        libreoffice-writer \
        fonts-dejavu \
        fontconfig \
        fonts-noto-cjk \
        fonts-crosextra-carlito \
        fonts-crosextra-caladea \
    && fc-cache -f \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 nonroot \
    && useradd --system --uid 65532 --gid nonroot --home-dir /tmp --shell /usr/sbin/nologin nonroot \
    && chown -R nonroot:nonroot /app
COPY --chown=nonroot:nonroot target/docgen-backend-*.jar app.jar
USER 65532:65532
EXPOSE 8080
ENV HOME=/tmp
ENV JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=/tmp"
ENTRYPOINT ["java", "-jar", "app.jar"]
