          "children": [
            {"type": "textRun", "value": "Available balance (after pending transactions): "},
            {"type": "emphasis", "variant": "bold", "children": [
              {"type": "variable", "key": "currency"},
              {"type": "textRun", "value": " "},
              {"type": "variable", "key": "availableBalance"}
