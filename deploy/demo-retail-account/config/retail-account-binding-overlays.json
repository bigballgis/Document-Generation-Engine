          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Balance Confirmation"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "We confirm that your "},
            {"type": "variable", "key": "accountType"},
            {"type": "textRun", "value": " held in the name of "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "customerName"}]},
            {"type": "textRun", "value": " (account number "},
            {"type": "underline", "children": [{"type": "variable", "key": "accountNumber"}]},
            {"type": "textRun", "value": ", sort code "},
            {"type": "variable", "key": "sortCode"},
            {"type": "textRun", "value": ") showed a cleared balance of "},
            {"type": "emphasis", "variant": "bold", "children": [
              {"type": "variable", "key": "currency"},
              {"type": "textRun", "value": " "},
              {"type": "variable", "key": "balanceAmount"}
