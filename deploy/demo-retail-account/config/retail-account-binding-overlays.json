        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Digital Banking Services"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "You may register for Meridian Online and Mobile Banking using the activation code enclosed with your welcome pack. Your relationship manager, "},
            {"type": "variable", "key": "relationshipManager"},
            {"type": "textRun", "value": ", can assist with registration (tel: "},
            {"type": "variable", "key": "contactPhone"},
            {"type": "textRun", "value": ")."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "For your security, never share your online banking credentials or one-time passcodes with anyone, including bank staff. We will never ask you to transfer money to a safe account."}
          ]
        }
      ]
    },
