        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Our ref: "},
            {"type": "variable", "key": "customerReference"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "To: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "customerName"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "variable", "key": "customerAddress"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "textRun", "value": "Dear Customer,"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Re: Account Opening Confirmation — "},
            {"type": "underline", "children": [{"type": "variable", "key": "accountNumber"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Branch: "},
            {"type": "variable", "key": "branchName"},
            {"type": "textRun", "value": ", "},
            {"type": "variable", "key": "branchAddress"},
            {"type": "textRun", "value": " (tel: "},
            {"type": "variable", "key": "branchPhone"},
            {"type": "textRun", "value": ")"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "We, "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "bankName"}]},
            {"type": "textRun", "value": " of "},
            {"type": "variable", "key": "bankAddress"},
            {"type": "textRun", "value": " (FCA "},
            {"type": "variable", "key": "bankFcaNumber"},
            {"type": "textRun", "value": "), are pleased to confirm the opening of your retail account."}
          ]
        }
      ]
    },
    "RAO_ACCOUNT_OPENING": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Account Opening Confirmation"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "We are pleased to confirm that your "},
            {"type": "variable", "key": "accountType"},
            {"type": "textRun", "value": " (the \"Account\") with account number "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "accountNumber"}]},
            {"type": "textRun", "value": " and sort code "},
            {"type": "underline", "children": [{"type": "variable", "key": "sortCode"}]},
            {"type": "textRun", "value": " was opened at our "},
            {"type": "variable", "key": "branchName"},
            {"type": "textRun", "value": " branch with effect from "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "openingDate"}]},
            {"type": "textRun", "value": "."}
          ]
        },
        {
          "type": "conditionBlock",
          "conditionExpression": "${includeJointAccount} == true",
          "children": [
            {
              "type": "paragraph",
              "styleRef": "ClauseBody",
              "children": [
                {"type": "textRun", "value": "The Account is held jointly with "},
                {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "jointHolderName"}]},
                {"type": "textRun", "value": ". Both account holders are jointly and severally liable for all amounts owing on the Account."}
              ]
            }
          ]
        },
        {
          "type": "conditionBlock",
          "conditionExpression": "${includeOverdraft} == true",
          "children": [
            {
              "type": "paragraph",
              "styleRef": "ClauseBody",
              "children": [
                {"type": "textRun", "value": "An arranged overdraft facility of up to "},
                {"type": "emphasis", "variant": "bold", "children": [
                  {"type": "variable", "key": "currency"},
                  {"type": "textRun", "value": " "},
                  {"type": "variable", "key": "overdraftLimit"}
                ]},
                {"type": "textRun", "value": " has been made available on the Account, subject to the terms set out in this letter and the Account terms and conditions."}
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Your "},
            {"type": "variable", "key": "debitCardType"},
            {"type": "textRun", "value": " debit card will be dispatched to your registered address within five working days of the account opening date."}
          ]
        }
      ]
    },
    "RAO_PRODUCT_TERMS": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Product Terms and Conditions"}]
        },
        {
          "type": "contentModuleRef",
          "referenceKey": "RETAIL-ACCOUNT-OPEN-STD"
        }
      ]
    },
    "RAO_FEE_SCHEDULE": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Fee Schedule"}]
        },
        {
          "type": "sectionHeading",
          "styleRef": "ScheduleTitle",
          "children": [
            {"type": "text", "value": "Schedule 1 — Account Fees and Charges (effective from account opening date)"}
          ]
        },
        {
          "type": "tableComponentRef",
          "tableComponent": {
            "componentKey": "RETAIL-TBL-FEE-SCHEDULE",
            "columnSchema": [
              {"columnKey": "feeType", "widthPct": 35},
              {"columnKey": "amount", "widthPct": 25},
              {"columnKey": "frequency", "widthPct": 20},
              {"columnKey": "notes", "widthPct": 20}
            ],
            "headerRows": [[
              {"columnKey": "feeType", "value": "Fee Type"},
              {"columnKey": "amount", "value": "Amount"},
              {"columnKey": "frequency", "value": "Frequency"},
              {"columnKey": "notes", "value": "Notes"}
            ]],
            "loopRow": {
              "loopVariable": "feeSchedule",
              "cells": [
                {"columnKey": "feeType", "variableKey": "feeType"},
                {"columnKey": "amount", "variableKey": "amount"},
                {"columnKey": "frequency", "variableKey": "frequency"},
                {"columnKey": "notes", "variableKey": "notes"}
              ]
            }
          }
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Fees are subject to change. We will give you at least 60 days' notice before increasing any fee that is not linked to a change in the Bank of England base rate. A full schedule of fees is available on request or at meridianretail.co.uk/fees."}
          ]
        }
      ]
    },
    "RAO_REGULATORY": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Regulatory Notice"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Your eligible deposits with "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "bankName"}]},
            {"type": "textRun", "value": " are protected up to a total of £85,000 by the Financial Services Compensation Scheme (FSCS), the UK's deposit guarantee scheme. Any deposits you hold above this limit are unlikely to be covered."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "This confirmation is provided for information purposes only and does not amend the terms and conditions governing your Account. Please read the enclosed Account terms and conditions carefully and contact us if you have any questions."}
          ]
        }
      ]
    },
    "RAO_DIGITAL_BANKING": {
      "schemaVersion": "1.0",
