{
  "catalogMarker": "wealth-demo-v3-bank-grade",
  "bindings": {
    "WST_PARTIES": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "imageRef", "imageRef": "IMG-1"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Statement Date: "},
            {"type": "variable", "key": "statementDate"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Our ref: "},
            {"type": "variable", "key": "clientReference"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "To: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "clientName"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "variable", "key": "clientAddress"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "textRun", "value": "Dear Valued Client,"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Re: Private Wealth Investment Statement — Portfolio Reference "},
            {"type": "underline", "children": [{"type": "variable", "key": "portfolioReference"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "We, "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "bankName"}]},
            {"type": "textRun", "value": " of "},
            {"type": "variable", "key": "bankAddress"},
            {"type": "textRun", "value": " (the Bank), are pleased to provide your Private Wealth Investment Statement for the period "},
            {"type": "variable", "key": "statementPeriod"},
            {"type": "textRun", "value": ", prepared in our capacity as investment manager and custodian."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Custodian: "},
            {"type": "variable", "key": "custodian"}
          ]
        },
        {
          "type": "conditionBlock",
          "conditionExpression": "${includeOffshoreHoldings} == true",
          "children": [
            {
              "type": "paragraph",
              "styleRef": "ClauseBody",
              "children": [
                {"type": "textRun", "value": "Offshore custody: Certain holdings are held through "},
                {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "offshoreCustodian"}]},
                {"type": "textRun", "value": " in accordance with the offshore custody agreement governing your account."}
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Your relationship manager is "},
            {"type": "variable", "key": "relationshipManager"},
            {"type": "textRun", "value": " (tel: "},
            {"type": "variable", "key": "relationshipManagerPhone"},
            {"type": "textRun", "value": "; email: "},
            {"type": "variable", "key": "relationshipManagerEmail"},
            {"type": "textRun", "value": ")."}
          ]
        }
      ]
    },
    "WST_DEFINED_TERMS": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Defined Terms"}]
        },
        {
          "type": "paragraph",
          "styleRef": "DefinedTerm",
          "children": [
            {"type": "textRun", "value": "\"Portfolio\""},
            {"type": "textRun", "value": " means the investment portfolio identified by reference "},
            {"type": "underline", "children": [{"type": "variable", "key": "portfolioReference"}]},
            {"type": "textRun", "value": " held in custody on your behalf as at the statement date."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "DefinedTerm",
          "children": [
            {"type": "textRun", "value": "\"Statement Period\""},
            {"type": "textRun", "value": " means "},
            {"type": "variable", "key": "statementPeriod"},
            {"type": "textRun", "value": "."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "DefinedTerm",
          "children": [
            {"type": "textRun", "value": "\"Base Currency\""},
            {"type": "textRun", "value": " means "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "baseCurrency"}]},
            {"type": "textRun", "value": ", being the currency in which portfolio values are aggregated for display purposes unless otherwise indicated."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "DefinedTerm",
          "children": [
            {"type": "textRun", "value": "\"Net Asset Value\" or \"NAV\""},
            {"type": "textRun", "value": " means the aggregate market value of all holdings plus cash balances, less any liabilities, expressed in the Base Currency as at the statement date."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "DefinedTerm",
          "children": [
            {"type": "textRun", "value": "\"Market Value\""},
            {"type": "textRun", "value": " means the value of a holding determined by reference to the closing market price on the statement date, or such other valuation methodology as described in the Important Notices section."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "DefinedTerm",
          "children": [
            {"type": "textRun", "value": "\"Unrealised Gain/Loss\""},
            {"type": "textRun", "value": " means the difference between the cost basis and the current market value of holdings, and does not represent a realised profit or loss until disposal."}
          ]
        }
      ]
    },
    "WST_PORTFOLIO_SUMMARY": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Portfolio Summary"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "The following summary presents the aggregate position of your Portfolio as at "},
            {"type": "variable", "key": "statementDate"},
            {"type": "textRun", "value": ". All amounts are expressed in "},
            {"type": "variable", "key": "baseCurrency"},
            {"type": "textRun", "value": " unless otherwise stated."}
          ]
        },
        {
          "type": "tableComponentRef",
          "tableComponent": {
            "componentKey": "WEALTH-TBL-SUMMARY-OVERVIEW",
            "columnSchema": [
              {"columnKey": "metric", "widthPct": 60},
              {"columnKey": "value", "widthPct": 40}
            ],
            "headerRows": [[
              {"columnKey": "metric", "value": "Portfolio Metric"},
              {"columnKey": "value", "value": "Amount"}
            ]],
            "footerRows": [
              [{"columnKey": "metric", "value": "Cash balance"}, {"columnKey": "value", "variableKey": "cashBalance"}],
              [{"columnKey": "metric", "value": "Total market value (investments)"}, {"columnKey": "value", "variableKey": "totalMarketValue"}],
              [{"columnKey": "metric", "value": "Net asset value (NAV)"}, {"columnKey": "value", "variableKey": "netAssetValue"}]
            ]
          }
        },
        {"type": "contentModuleRef", "referenceKey": "WEALTH-STATEMENT-INTRO"}
      ]
    },
    "WST_HOLDINGS_EQUITY": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Equity Holdings"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "The table below sets out the equity and equity fund holdings in your Portfolio. Weight percentages represent each holding's proportion of total NAV."}
          ]
        },
        {
          "type": "tableComponentRef",
          "tableComponent": {
            "componentKey": "WEALTH-TBL-EQUITY",
            "columnSchema": [
              {"columnKey": "instrument", "widthPct": 35},
              {"columnKey": "quantity", "widthPct": 15},
              {"columnKey": "marketPrice", "widthPct": 15},
              {"columnKey": "marketValue", "widthPct": 20},
              {"columnKey": "weightPct", "widthPct": 15}
            ],
            "headerRows": [[
              {"columnKey": "instrument", "value": "Instrument"},
              {"columnKey": "quantity", "value": "Quantity"},
              {"columnKey": "marketPrice", "value": "Market Price"},
              {"columnKey": "marketValue", "value": "Market Value"},
              {"columnKey": "weightPct", "value": "Weight %"}
            ]],
            "loopRow": {
              "loopVariable": "equityHoldings",
              "cells": [
                {"columnKey": "instrument", "variableKey": "instrument"},
                {"columnKey": "quantity", "variableKey": "quantity"},
                {"columnKey": "marketPrice", "variableKey": "marketPrice"},
                {"columnKey": "marketValue", "variableKey": "marketValue"},
                {"columnKey": "weightPct", "variableKey": "weightPct"}
              ]
            }
          }
        }
      ]
    },
    "WST_HOLDINGS_FIXED_INCOME": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Fixed Income Holdings"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "The table below sets out the fixed income and bond fund holdings in your Portfolio, including government bonds, corporate bonds and bond funds."}
          ]
        },
        {
          "type": "tableComponentRef",
          "tableComponent": {
            "componentKey": "WEALTH-TBL-FIXED-INCOME",
            "columnSchema": [
              {"columnKey": "instrument", "widthPct": 35},
              {"columnKey": "quantity", "widthPct": 15},
              {"columnKey": "marketPrice", "widthPct": 15},
              {"columnKey": "marketValue", "widthPct": 20},
              {"columnKey": "weightPct", "widthPct": 15}
            ],
            "headerRows": [[
              {"columnKey": "instrument", "value": "Instrument"},
              {"columnKey": "quantity", "value": "Quantity / Nominal"},
              {"columnKey": "marketPrice", "value": "Market Price"},
              {"columnKey": "marketValue", "value": "Market Value"},
              {"columnKey": "weightPct", "value": "Weight %"}
            ]],
            "loopRow": {
              "loopVariable": "fixedIncomeHoldings",
              "cells": [
                {"columnKey": "instrument", "variableKey": "instrument"},
                {"columnKey": "quantity", "variableKey": "quantity"},
                {"columnKey": "marketPrice", "variableKey": "marketPrice"},
                {"columnKey": "marketValue", "variableKey": "marketValue"},
                {"columnKey": "weightPct", "variableKey": "weightPct"}
              ]
            }
          }
        }
      ]
    },
    "WST_HOLDINGS_ALTERNATIVES": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Alternative Assets"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "The table below sets out alternative asset holdings including private equity, infrastructure and other illiquid investments. Valuations for unlisted instruments are based on the most recent independent appraisal."}
          ]
        },
        {
          "type": "tableComponentRef",
          "tableComponent": {
            "componentKey": "WEALTH-TBL-ALTERNATIVES",
            "columnSchema": [
              {"columnKey": "instrument", "widthPct": 35},
              {"columnKey": "quantity", "widthPct": 15},
              {"columnKey": "marketPrice", "widthPct": 15},
              {"columnKey": "marketValue", "widthPct": 20},
              {"columnKey": "weightPct", "widthPct": 15}
            ],
            "headerRows": [[
              {"columnKey": "instrument", "value": "Instrument"},
              {"columnKey": "quantity", "value": "Units / Shares"},
              {"columnKey": "marketPrice", "value": "NAV per Unit"},
              {"columnKey": "marketValue", "value": "Market Value"},
              {"columnKey": "weightPct", "value": "Weight %"}
            ]],
            "loopRow": {
              "loopVariable": "alternativeHoldings",
              "cells": [
                {"columnKey": "instrument", "variableKey": "instrument"},
                {"columnKey": "quantity", "variableKey": "quantity"},
                {"columnKey": "marketPrice", "variableKey": "marketPrice"},
                {"columnKey": "marketValue", "variableKey": "marketValue"},
                {"columnKey": "weightPct", "variableKey": "weightPct"}
              ]
            }
          }
        }
      ]
    },
    "WST_INCOME_ACTIVITY": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Income Activity"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "The following table summarises income received during the Statement Period, including dividends, coupon payments and interest credited to your account."}
          ]
        },
        {
          "type": "tableComponentRef",
          "tableComponent": {
            "componentKey": "WEALTH-TBL-INCOME",
            "columnSchema": [
              {"columnKey": "description", "widthPct": 50},
              {"columnKey": "date", "widthPct": 25},
              {"columnKey": "amount", "widthPct": 25}
            ],
            "headerRows": [[
              {"columnKey": "description", "value": "Description"},
              {"columnKey": "date", "value": "Date"},
              {"columnKey": "amount", "value": "Amount"}
            ]],
            "loopRow": {
              "loopVariable": "incomeItems",
              "cells": [
                {"columnKey": "description", "variableKey": "description"},
                {"columnKey": "date", "variableKey": "date"},
                {"columnKey": "amount", "variableKey": "amount"}
              ]
            }
          }
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Total dividends received: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "dividendsReceived"}]},
            {"type": "textRun", "value": ". Total interest received: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "interestReceived"}]},
            {"type": "textRun", "value": "."}
          ]
        }
      ]
    },
    "WST_PORTFOLIO_TOTALS": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Portfolio Totals"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "The following summary presents the aggregate cost basis, market value, unrealised gain/loss and total income for the Statement Period."}
          ]
        },
        {
          "type": "tableComponentRef",
          "tableComponent": {
            "componentKey": "WEALTH-TBL-TOTALS",
            "columnSchema": [
              {"columnKey": "label", "widthPct": 60},
              {"columnKey": "amount", "widthPct": 40}
            ],
            "headerRows": [[
              {"columnKey": "label", "value": "Summary"},
              {"columnKey": "amount", "value": "Amount"}
            ]],
            "footerRows": [
              [{"columnKey": "label", "value": "Total cost basis"}, {"columnKey": "amount", "variableKey": "totalCost"}],
              [{"columnKey": "label", "value": "Total market value"}, {"columnKey": "amount", "variableKey": "totalMarketValue"}],
              [{"columnKey": "label", "value": "Unrealised gain/loss"}, {"columnKey": "amount", "variableKey": "unrealisedGainLoss"}],
              [{"columnKey": "label", "value": "Unrealised gain/loss %"}, {"columnKey": "amount", "variableKey": "unrealisedGainLossPct"}],
              [{"columnKey": "label", "value": "Total income received (period)"}, {"columnKey": "amount", "variableKey": "incomeReceived"}]
            ]
          }
        }
      ]
    },
    "WST_DISCLAIMERS_SIGNATURE": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading3",
          "numbering": {"level": 2},
          "children": [{"type": "text", "value": "Important Notices"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "This statement is provided for information purposes only and does not constitute investment advice, an offer to sell or a solicitation of an offer to buy any securities or investment products. "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "textRun", "value": "Past performance is not indicative of future results."}]},
            {"type": "textRun", "value": " The value of investments and income from them may go down as well as up, and investors may not get back the amount originally invested."}
          ]
        },
        {"type": "contentModuleRef", "referenceKey": "WEALTH-REGULATORY-NOTICE"},
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "If you have any queries regarding this statement or wish to discuss your Portfolio, please contact your Relationship Manager."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "textRun", "value": "Yours sincerely,"}]
        },
        {
          "type": "paragraph",
          "styleRef": "SignatureBlock",
          "children": [{"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "signatoryName"}]}]
        },
        {
          "type": "paragraph",
          "styleRef": "SignatureBlock",
          "children": [{"type": "variable", "key": "signatoryTitle"}]
        },
        {
          "type": "paragraph",
          "styleRef": "SignatureBlock",
          "children": [
            {"type": "variable", "key": "bankName"},
            {"type": "textRun", "value": ", "},
            {"type": "variable", "key": "bankAddress"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "SignatureBlock",
          "children": [
            {"type": "textRun", "value": "FCA Register No. "},
            {"type": "variable", "key": "bankFcaNumber"}
          ]
        }
      ]
    }
  }
}
