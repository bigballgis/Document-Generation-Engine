          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Payment under a complying demand will be made by telegraphic transfer within five banking days of receipt, value two working days, less any disclosed fees at our standard tariff."}
