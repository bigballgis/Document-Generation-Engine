{
  "catalogMarker": "collection-demo-v3-bank-grade",
  "bindings": {
    "RCN_PARTIES": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Date: "},
            {"type": "variable", "key": "letterDate"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Our ref: "},
            {"type": "variable", "key": "customerReference"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "To: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "customerName"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "variable", "key": "customerAddress"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "textRun", "value": "Dear Customer,"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Re: "},
            {"type": "variable", "key": "letterType"},
            {"type": "textRun", "value": " — Account "},
            {"type": "underline", "children": [{"type": "variable", "key": "accountNumber"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Branch: "},
            {"type": "variable", "key": "branchName"},
            {"type": "textRun", "value": " | "},
            {"type": "variable", "key": "bankName"},
            {"type": "textRun", "value": " (FCA "},
            {"type": "variable", "key": "bankFcaNumber"},
            {"type": "textRun", "value": ")"}
          ]
        }
      ]
    },
    "RCN_RATE_NOTICE": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Rate Variation Notice"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "We are writing to notify you, in accordance with the terms and conditions governing your "},
            {"type": "variable", "key": "accountType"},
            {"type": "textRun", "value": " (the \"Account\"), of a change to the interest rate applicable to the Account held with "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "bankName"}]},
            {"type": "textRun", "value": "."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "The interest rate on the Account will change from "},
            {"type": "variable", "key": "oldRate"},
            {"type": "textRun", "value": " to "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "newRate"}]},
            {"type": "textRun", "value": ", with effect from "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "effectiveDate"}]},
            {"type": "textRun", "value": "."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Your cleared balance as at the date of this notice is "},
            {"type": "emphasis", "variant": "bold", "children": [
              {"type": "variable", "key": "currency"},
              {"type": "textRun", "value": " "},
              {"type": "variable", "key": "accountBalance"}
            ]},
            {"type": "textRun", "value": ". The change reflects "},
            {"type": "variable", "key": "rateChangeReason"},
            {"type": "textRun", "value": "."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "We will give you at least "},
            {"type": "underline", "children": [{"type": "variable", "key": "noticePeriodDays"}]},
            {"type": "textRun", "value": " days' personal notice before this rate change takes effect, in line with FCA CONC requirements."}
          ]
        }
      ]
    },
    "RCN_REGULATORY": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Regulatory Notice"}]
        },
        {
          "type": "contentModuleRef",
          "referenceKey": "COLLECTION-RATE-CHANGE-CLAUSE"
        }
      ]
    },
    "RCN_RIGHT_TO_SWITCH": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Right to Switch"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "If you are dissatisfied with the change, you may switch your Account to an alternative product we offer, or close your Account without charge and without penalty, at any time before the effective date by contacting us using the details below."}
          ]
        },
        {
          "type": "conditionBlock",
          "conditionExpression": "${includeFixedRateExclusion} == true",
          "children": [
            {
              "type": "paragraph",
              "styleRef": "ClauseBody",
              "children": [
                {"type": "textRun", "value": "Fixed-rate products: This notice does not apply during the fixed-rate period. We will write to you separately when your fixed rate ends."}
              ]
            }
          ]
        }
      ]
    },
    "RCN_INTEREST_CALC": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Interest Calculation"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Gross rate: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "grossRate"}]},
            {"type": "textRun", "value": " | AER: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "aerRate"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Interest is calculated daily on the cleared credit balance and applied monthly. The Annual Equivalent Rate (AER) illustrates what the interest rate would be if interest was paid and compounded once each year."}
          ]
        }
      ]
    },
    "RCN_TAX_CONTACT": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Tax and Contact"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Interest is paid gross. You may be liable to pay tax on the interest you receive in accordance with the laws of the United Kingdom."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "If you have any questions, please contact your Relationship Manager "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "relationshipManager"}]},
            {"type": "textRun", "value": " on "},
            {"type": "underline", "children": [{"type": "variable", "key": "contactPhone"}]},
            {"type": "textRun", "value": "."}
          ]
        }
      ]
    },
    "RCN_SIGNATURE": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "textRun", "value": "Yours sincerely,"}]
        },
        {
          "type": "paragraph",
          "styleRef": "SignatureBlock",
          "children": [{"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "signatoryName"}]}]
        },
        {
          "type": "paragraph",
          "styleRef": "SignatureBlock",
          "children": [{"type": "variable", "key": "signatoryTitle"}]
        },
        {
          "type": "paragraph",
          "styleRef": "SignatureBlock",
          "children": [
            {"type": "variable", "key": "bankName"},
            {"type": "textRun", "value": ", "},
            {"type": "variable", "key": "bankAddress"}
          ]
        }
      ]
    },
    "RCN_DISCLAIMER": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading3",
          "numbering": {"level": 2},
          "children": [{"type": "text", "value": "Important Information"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "This notice is issued for information purposes only and does not amend the terms and conditions of your Account. "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "textRun", "value": "Meridian Retail Banking"}]},
            {"type": "textRun", "value": " is authorised by the Prudential Regulation Authority and regulated by the Financial Conduct Authority and the Prudential Regulation Authority. Our FCA register number is "},
            {"type": "variable", "key": "bankFcaNumber"},
            {"type": "textRun", "value": ". Please retain this letter for your records."}
          ]
        }
      ]
    },
    "OCN_PARTIES": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Date: "},
            {"type": "variable", "key": "letterDate"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Our ref: "},
            {"type": "variable", "key": "customerReference"}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "To: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "customerName"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "variable", "key": "customerAddress"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "textRun", "value": "Dear Customer,"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Re: "},
            {"type": "variable", "key": "letterType"},
            {"type": "textRun", "value": " — Account "},
            {"type": "underline", "children": [{"type": "variable", "key": "accountNumber"}]}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Branch: "},
            {"type": "variable", "key": "branchName"},
            {"type": "textRun", "value": " | Payment reference: "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "paymentReference"}]}
          ]
        }
      ]
    },
    "OCN_ARREARS": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Overdue Balance Notice"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Our records show that your "},
            {"type": "variable", "key": "accountType"},
            {"type": "textRun", "value": " with "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "bankName"}]},
            {"type": "textRun", "value": " has an overdue balance of "},
            {"type": "emphasis", "variant": "bold", "children": [
              {"type": "variable", "key": "currency"},
              {"type": "textRun", "value": " "},
              {"type": "variable", "key": "overdueAmount"}
            ]},
            {"type": "textRun", "value": ", which was due for payment on "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "dueDate"}]},
            {"type": "textRun", "value": " and is now "},
            {"type": "variable", "key": "daysOverdue"},
            {"type": "textRun", "value": " days overdue."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Total outstanding balance (including accrued interest): "},
            {"type": "underline", "children": [
              {"type": "variable", "key": "currency"},
              {"type": "textRun", "value": " "},
              {"type": "variable", "key": "totalOutstanding"}
            ]},
            {"type": "textRun", "value": ". Arrears stage: "},
            {"type": "variable", "key": "arrearsStage"},
            {"type": "textRun", "value": "."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Please contact us immediately to discuss repayment arrangements. We are committed to treating customers fairly throughout the collections process, in accordance with FCA CONC."}
          ]
        }
      ]
    },
    "OCN_REGULATORY": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Regulatory Notice"}]
        },
        {
          "type": "contentModuleRef",
          "referenceKey": "COLLECTION-OVERDUE-CLAUSE"
        }
      ]
    },
    "OCN_REPAYMENT": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Repayment Options"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Minimum payment required to bring your Account up to date: "},
            {"type": "emphasis", "variant": "bold", "children": [
              {"type": "variable", "key": "currency"},
              {"type": "textRun", "value": " "},
              {"type": "variable", "key": "minimumPayment"}
            ]},
            {"type": "textRun", "value": ". Please quote payment reference "},
            {"type": "underline", "children": [{"type": "variable", "key": "paymentReference"}]},
            {"type": "textRun", "value": " when making payment."}
          ]
        },
        {
          "type": "sectionHeading",
          "styleRef": "ScheduleTitle",
          "children": [{"type": "text", "value": "Repayment Methods"}]
        },
        {
          "type": "tableComponentRef",
          "tableComponent": {
            "componentKey": "COLLECTION-TBL-REPAYMENT",
            "columnSchema": [
              {"columnKey": "method", "widthPct": 35},
              {"columnKey": "details", "widthPct": 65}
            ],
            "headerRows": [[
              {"columnKey": "method", "value": "Method"},
              {"columnKey": "details", "value": "Details"}
            ]],
            "loopRow": {
              "loopVariable": "repaymentMethods",
              "cells": [
                {"columnKey": "method", "variableKey": "method"},
                {"columnKey": "details", "variableKey": "details"}
              ]
            }
          }
        }
      ]
    },
    "OCN_CONSEQUENCES": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Consequences of Non-Payment"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "Default interest may be applied at "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "defaultInterestRate"}]},
            {"type": "textRun", "value": " on the overdue balance until payment is received in full."}
          ]
        },
        {
          "type": "conditionBlock",
          "conditionExpression": "${arrearsStage} == 'FINAL_NOTICE'",
          "children": [
            {
              "type": "paragraph",
              "styleRef": "ClauseBody",
              "children": [
                {"type": "textRun", "value": "FINAL NOTICE: Failure to bring your Account up to date within 14 days may result in referral to an external collections agency and a record on your credit file held by credit reference agencies."}
              ]
            }
          ]
        },
        {
          "type": "conditionBlock",
          "conditionExpression": "${arrearsStage} != 'FINAL_NOTICE'",
          "children": [
            {
              "type": "paragraph",
              "styleRef": "ClauseBody",
              "children": [
                {"type": "textRun", "value": "Failure to bring your Account up to date may result in additional charges, suspension of further credit, and a record of arrears on your credit file."}
              ]
            }
          ]
        }
      ]
    },
    "OCN_SUPPORT": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading2",
          "numbering": {"level": 1},
          "children": [{"type": "text", "value": "Support and Complaints"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "If you are experiencing financial difficulty, please contact your Relationship Manager "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "relationshipManager"}]},
            {"type": "textRun", "value": " on "},
            {"type": "variable", "key": "contactPhone"},
            {"type": "textRun", "value": ". Free debt advice is available from StepChange (0800 138 1111) and Money Helper (0800 138 7777)."}
          ]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "If you are dissatisfied with the way we have handled your Account, you may refer your complaint to the Financial Ombudsman Service (0800 023 4567)."}
          ]
        }
      ]
    },
    "OCN_SIGNATURE": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [{"type": "textRun", "value": "Yours sincerely,"}]
        },
        {
          "type": "paragraph",
