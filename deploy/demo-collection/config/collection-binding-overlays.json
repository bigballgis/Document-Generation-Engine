{
  "catalogMarker": "collection-demo-v2-real",
  "bindings": {
    "RATE_CHANGE_BODY": {
      "schemaVersion": "1.0",
      "nodes": [
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Date: "},
          {"type": "variable", "key": "letterDate"}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "To: "},
          {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "customerName"}]},
          {"type": "textRun", "value": ", "},
          {"type": "variable", "key": "customerAddress"}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Dear Customer,"}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Re: Notice of Variation of Interest Rate — Account "},
          {"type": "underline", "children": [{"type": "variable", "key": "accountNumber"}]}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "We are writing to notify you, in accordance with the terms and conditions governing your "},
          {"type": "variable", "key": "accountType"},
          {"type": "textRun", "value": " (the \"Account\"), of a change to the interest rate applicable to the Account held with "},
          {"type": "variable", "key": "bankName"},
          {"type": "textRun", "value": "."}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "The interest rate on the Account will change from "},
          {"type": "variable", "key": "oldRate"},
          {"type": "textRun", "value": " to "},
          {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "newRate"}]},
          {"type": "textRun", "value": ", with effect from "},
          {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "effectiveDate"}]},
          {"type": "textRun", "value": "."}
        ]},
        {"type": "contentModuleRef", "referenceKey": "COLLECTION-RATE-CHANGE-CLAUSE"},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Yours sincerely,"}
        ]},
        {"type": "paragraph", "children": [{"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "signatoryName"}]}]},
        {"type": "paragraph", "children": [{"type": "variable", "key": "signatoryTitle"}]},
        {"type": "paragraph", "children": [{"type": "variable", "key": "bankName"}, {"type": "textRun", "value": ", "}, {"type": "variable", "key": "bankAddress"}]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Relationship Manager: "},
          {"type": "variable", "key": "relationshipManager"},
          {"type": "textRun", "value": " | "},
          {"type": "variable", "key": "contactPhone"}
        ]}
      ]
    },
    "OVERDUE_COLLECTION_BODY": {
      "schemaVersion": "1.0",
      "nodes": [
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Date: "},
          {"type": "variable", "key": "letterDate"}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "To: "},
          {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "customerName"}]},
          {"type": "textRun", "value": ", "},
          {"type": "variable", "key": "customerAddress"}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Dear Customer,"}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Re: Overdue Balance — Account "},
          {"type": "underline", "children": [{"type": "variable", "key": "accountNumber"}]}
        ]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Our records show that your "},
          {"type": "variable", "key": "accountType"},
          {"type": "textRun", "value": " (the \"Account\") with "},
          {"type": "variable", "key": "bankName"},
          {"type": "textRun", "value": " has an overdue balance of "},
          {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "currency"}, {"type": "textRun", "value": " "}, {"type": "variable", "key": "overdueAmount"}]},
          {"type": "textRun", "value": ", which was due for payment on "},
          {"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "dueDate"}]},
          {"type": "textRun", "value": " and is now "},
          {"type": "variable", "key": "daysOverdue"},
          {"type": "textRun", "value": " days overdue."}
        ]},
        {"type": "contentModuleRef", "referenceKey": "COLLECTION-OVERDUE-CLAUSE"},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Yours sincerely,"}
        ]},
        {"type": "paragraph", "children": [{"type": "emphasis", "variant": "bold", "children": [{"type": "variable", "key": "signatoryName"}]}]},
        {"type": "paragraph", "children": [{"type": "variable", "key": "signatoryTitle"}]},
        {"type": "paragraph", "children": [{"type": "variable", "key": "bankName"}, {"type": "textRun", "value": ", "}, {"type": "variable", "key": "bankAddress"}]},
        {"type": "paragraph", "children": [
          {"type": "textRun", "value": "Relationship Manager: "},
          {"type": "variable", "key": "relationshipManager"},
          {"type": "textRun", "value": " | "},
          {"type": "variable", "key": "contactPhone"}
        ]}
      ]
    }
  }
}
