            {"type": "variable", "key": "bankName"},
            {"type": "textRun", "value": ", "},
            {"type": "variable", "key": "bankAddress"}
          ]
        }
      ]
    },
    "OCN_DISCLAIMER": {
      "schemaVersion": "1.0",
      "nodes": [
        {
          "type": "sectionHeading",
          "styleRef": "Heading3",
          "numbering": {"level": 2},
          "children": [{"type": "text", "value": "Important Information"}]
        },
        {
          "type": "paragraph",
          "styleRef": "ClauseBody",
          "children": [
            {"type": "textRun", "value": "This notice is issued in accordance with our collections policy and FCA CONC. "},
            {"type": "emphasis", "variant": "bold", "children": [{"type": "textRun", "value": "Meridian Retail Banking"}]},
            {"type": "textRun", "value": " is authorised by the Prudential Regulation Authority and regulated by the Financial Conduct Authority and the Prudential Regulation Authority (FCA "},
            {"type": "variable", "key": "bankFcaNumber"},
            {"type": "textRun", "value": "). Please retain this letter for your records."}
          ]
        }
      ]
    }
  }
